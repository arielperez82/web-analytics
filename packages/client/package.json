{
  "name": "tinybird-analytics",
  "type": "module",
  "version": "1.1.1",
  "description": "Complete analytics solution for Tinybird with Analytics.js integration",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "analytics",
    "tinybird",
    "tracking",
    "web-analytics",
    "analytics.js"
  ],
  "author": "Ariel Pérez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arielperez82/web-analytics/client.git"
  },
  "homepage": "https://github.com/arielperez82/web-analytics/client#readme",
  "bugs": {
    "url": "https://github.com/arielperez82/web-analytics/issues"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "prepare": "pnpm build",
    "lint:format:code": "prettier --check '*.{js,ts,json,yaml}'",
    "lint:format:code:fix": "prettier --write '*.{js,ts,json,yaml}'",
    "lint:code": "eslint",
    "lint:code:fix": "eslint --fix",
    "lint": "pnpm run lint:format:code && pnpm run lint:code",
    "lint:fix": "pnpm run lint:format:code:fix && pnpm run lint:code:fix"
  },
  "dependencies": {
    "analytics": "^0.8.19",
    "analytics-plugin-do-not-track": "^0.1.5",
    "countries-and-timezones": "^3.11.0",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "prettier": "^3.9.10",
    "prettier-plugin-sort-imports": "^1.8.11",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
