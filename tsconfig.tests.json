{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": [
    "acceptance/**/*.ts",
    "e2e/**/*.ts",
    "testing/**/*.ts",
    "scripts/**/*.ts",
    "vitest.acceptance.config.ts",
    "vitest.e2e.config.ts"
  ]
}
