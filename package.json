{
  "name": "web-analytics",
  "type": "module",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "check:tinybird": "cd apps/tinybird && pnpm exec tinybird deploy --check",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "lint:md": "markdownlint .",
    "lint:md:fix": "markdownlint --fix .",
    "lint:format:md": "prettier --check '*.md'",
    "lint:format:md:fix": "prettier --write '*.md'",
    "lint:format:code": "pnpm --filter tinybird-analytics lint:format:code && pnpm run lint:format:tests",
    "lint:format:code:fix": "pnpm --filter tinybird-analytics lint:format:code:fix && pnpm run lint:format:tests:fix",
    "lint:code": "pnpm --filter tinybird-analytics lint:code && pnpm run lint:code:tests",
    "lint:code:fix": "pnpm --filter tinybird-analytics lint:code:fix && pnpm run lint:code:tests:fix",
    "lint:code:tests": "eslint acceptance e2e testing scripts vitest.acceptance.config.ts vitest.e2e.config.ts eslint.config.js",
    "lint:code:tests:fix": "eslint --fix acceptance e2e testing scripts vitest.acceptance.config.ts vitest.e2e.config.ts eslint.config.js",
    "lint:format:tests": "prettier --config prettier.tests.config.js --check 'acceptance/**/*.ts' 'e2e/**/*.ts' 'testing/**/*.ts' 'scripts/**/*.ts' vitest.acceptance.config.ts vitest.e2e.config.ts eslint.config.js",
    "lint:format:tests:fix": "prettier --config prettier.tests.config.js --write 'acceptance/**/*.ts' 'e2e/**/*.ts' 'testing/**/*.ts' 'scripts/**/*.ts' vitest.acceptance.config.ts vitest.e2e.config.ts eslint.config.js",
    "typecheck:tinybird": "cd apps/tinybird && pnpm exec tsc",
    "test:client": "pnpm --filter tinybird-analytics test",
    "test:dashboard": "pnpm --filter @web-analytics/dashboard test",
    "typecheck:dashboard": "pnpm --filter @web-analytics/dashboard typecheck",
    "build:dashboard": "pnpm --filter @web-analytics/dashboard build",
    "test:acceptance:tinybird": "vitest run --config vitest.acceptance.config.ts",
    "test:acceptance:tinybird:local": "MANAGE_TB_LOCAL=1 vitest run --config vitest.acceptance.config.ts",
    "test:acceptance:client": "playwright test --project=client-acceptance",
    "test:e2e:browser": "playwright test -c playwright.e2e.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:local": "MANAGE_TB_LOCAL=1 vitest run --config vitest.e2e.config.ts",
    "test": "pnpm run test:client && pnpm run test:dashboard && pnpm run typecheck:dashboard && pnpm run typecheck:tinybird && pnpm run test:scripts && pnpm run check:workspace",
    "build:tinybird": "cd apps/tinybird && pnpm exec tinybird build",
    "test:scripts": "vitest run --dir scripts",
    "check:workspace": "tsx scripts/workspace/check-workspace.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@vitest/eslint-plugin": "^1.6.28",
    "dotenv-cli": "^11.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli": "^0.50.0",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
