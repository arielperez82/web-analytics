{
  "name": "web-analytics",
  "type": "module",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "check:tinybird": "cd tinybird && tb --cloud deployment create --check",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "lint:md": "markdownlint .",
    "lint:md:fix": "markdownlint --fix .",
    "lint:format:md": "prettier --check '*.md'",
    "lint:format:md:fix": "prettier --write '*.md'",
    "lint:format:code": "pnpm --filter tinybird-analytics lint:format:code && pnpm run lint:format:e2e",
    "lint:format:code:fix": "pnpm --filter tinybird-analytics lint:format:code:fix && pnpm run lint:format:e2e:fix",
    "lint:code": "pnpm --filter tinybird-analytics lint:code && pnpm run lint:code:e2e",
    "lint:code:fix": "pnpm --filter tinybird-analytics lint:code:fix && pnpm run lint:code:e2e:fix",
    "lint:code:e2e": "eslint e2e vitest.e2e.config.ts eslint.config.js",
    "lint:code:e2e:fix": "eslint --fix e2e vitest.e2e.config.ts eslint.config.js",
    "lint:format:e2e": "prettier --config prettier.e2e.config.js --check 'e2e/**/*.ts' vitest.e2e.config.ts eslint.config.js",
    "lint:format:e2e:fix": "prettier --config prettier.e2e.config.js --write 'e2e/**/*.ts' vitest.e2e.config.ts eslint.config.js",
    "test:tinybird": "cd tinybird && tb test run",
    "test:client": "pnpm --filter tinybird-analytics test",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test": "pnpm run test:client && pnpm run test:tinybird",
    "build:tinybird": "cd tinybird && tb build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/eslint-plugin": "^1.6.28",
    "dotenv-cli": "^11.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli": "^0.50.0",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
