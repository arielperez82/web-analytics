# Tinybird (server-side only; never exposed to the browser)
TINYBIRD_HOST=http://localhost:7181
TINYBIRD_TOKEN=
# Pins every query to this tenant; the browser cannot override it
DASHBOARD_TENANT_ID=

# Conversion goals: JSON array of {name, path}. Path starts with / and has no %, ? or #.
# Bad entries are dropped and reported on the dashboard. At most 10.
DASHBOARD_GOALS=[{"name":"Signed up","path":"/thanks"}]

# Identity proxy (POST /api/tracking), server-side only
TRACKING_TINYBIRD_TOKEN=
IDENTITY_SALT_SECRET=generate-with-openssl-rand-base64-32
# origin=tenant pairs, comma-separated. Several origins may share one tenant.
# The proxy stamps tenant_id and domain (the origin host) on every event.
TRACKING_ALLOWED_ORIGINS=https://example.com=acme
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# next-auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Access policy: who may sign in. Set per deployment; empty denies everyone.
# ALLOWED_EMAIL_DOMAINS: comma-separated, exact match (example.com does not admit sub.example.com)
# ALLOWED_EMAILS: comma-separated individual addresses, in addition to the domains
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=you@example.com

# Google OAuth client for this deployment (local: your own test client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local only. Ignored when NODE_ENV=production.
DASHBOARD_DEV_LOGIN=1
