# Tinybird (server-side only; never exposed to the browser)
TINYBIRD_HOST=http://localhost:7181
TINYBIRD_TOKEN=

# next-auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Access policy. Prod: ALLOWED_EMAIL_DOMAINS=splicelabs.xyz
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=you@example.com

# Google OAuth client (prod: the Splice client; local: your own test client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local only. Ignored when NODE_ENV=production.
DASHBOARD_DEV_LOGIN=1
